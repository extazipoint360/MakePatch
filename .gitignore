# --- Инструменты сборки патча: локальные, в репозиторий не нужны ---
*.py
*.bat

# --- Кэш/логи сборки манифеста ---
.manifest_hashcache.json
manifest-build.log
grl_manifest_*.json

# --- Временные и служебные файлы ---
*.tmp
*.part
*.grltmp
