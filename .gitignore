*.log

# --- Временные варианты бандлов (не финальные) ---
*.fresh
*.new

# --- Списки хэшей и архивы: контент уже распакован, игроку не нужны ---
*.hashes.txt
*.rar
*.zip
*.7z

# --- Мусор ОС / IDE ---
Thumbs.db
desktop.ini
.DS_Store
